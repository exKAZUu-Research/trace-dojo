{
  "name": "trace-dojo",
  "version": "0.0.0-semantically-released",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exKAZUu-Research/trace-dojo.git"
  },
  "license": "Apache-2.0",
  "author": "Kazunori Sakamoto",
  "scripts": {
    "build": "wb buildIfNeeded -c 'bun run build/core'",
    "build/core": "next build",
    "calculate-score": "WB_ENV=production bun wb dotenv -- env DATABASE_URL=file:./drizzle/restored.sqlite3 bun db/calculateScores.ts",
    "chakra": "sh -c 'chakra-cli tokens \"$2\"' --",
    "cleanup": "bun wb lint --fix --format",
    "db-create-migration": "bun wb db migrate-dev",
    "db-help": "wb db --help",
    "db-migrate": "bun wb db migrate --check-idempotency",
    "db-migrate-apply": "wb db migrate",
    "db-migrate-create": "wb db migrate-dev",
    "db-reset": "wb db reset",
    "db-restore": "wb db restore",
    "db-view": "wb db studio",
    "db-view-restored": "bun wb dotenv -- env DATABASE_URL=file:./drizzle/restored.sqlite3 drizzle-kit studio",
    "deploy": "wb optimizeForDockerBuild --outside && bun wb dotenv -- node scripts/syncFlySecrets.mjs && fly deploy --local-only -c fly-${WB_ENV}.toml --build-arg ARCH=x86_64 --build-arg WB_ENV=${WB_ENV} --build-arg WB_VERSION=${WB_VERSION}",
    "format": "bun wb lint --format",
    "format-code": "oxfmt --write --no-error-on-unmatched-pattern . '!**/package.json'",
    "gen-code": "bun wb gen-code && chakra-cli tokens src/theme.ts",
    "postinstall": "bun wb gen-code",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "seed": "node --experimental-strip-types db/seed.ts",
    "start": "wb start",
    "start-docker": "WB_ENV=test wb start --mode docker",
    "start-stg": "WB_ENV=test wb start --mode staging",
    "test": "bun wb test",
    "test-unit": "wb test --unit",
    "test/ci": "bun wb test-on-ci",
    "test/ci-setup": "wb db reset",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "resolutions": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0"
  },
  "dependencies": {
    "@chakra-ui/anatomy": "2.3.6",
    "@chakra-ui/next-js": "2.4.2",
    "@chakra-ui/react": "2.10.9",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@orpc/client": "1.15.0",
    "@rvf/set-get": "7.0.3",
    "@tanstack/react-query": "5.102.8",
    "@trpc/client": "11.18.0",
    "@trpc/next": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "@willbooster/shared-lib": "10.5.0",
    "@willbooster/shared-lib-react": "6.3.0",
    "@willbooster/wb": "22.3.3",
    "at-decorators": "7.1.2",
    "csv-parse": "7.0.2",
    "dayjs": "1.11.23",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "fast-deep-equal": "3.1.3",
    "immer": "11.1.18",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "4.1.0",
    "motion": "12.43.0",
    "next": "16.3.5",
    "nextjs-cors": "2.2.1",
    "nextjs-toploader": "3.9.17",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-idle-timer": "5.7.3",
    "react-syntax-highlighter": "16.1.1",
    "seedrandom": "3.0.5",
    "server-only": "0.0.1",
    "superjson": "2.2.6",
    "supertokens-auth-react": "0.51.3",
    "supertokens-node": "24.0.3",
    "supertokens-web-js": "0.16.0",
    "use-context-selector": "2.0.0",
    "use-immer": "0.11.0",
    "usehooks-ts": "3.1.1",
    "uuid": "14.0.2",
    "zod": "4.5.4",
    "zod-form-data": "3.0.3"
  },
  "devDependencies": {
    "@chakra-ui/cli": "2.5.8",
    "@chakra-ui/styled-system": "2.12.5",
    "@types/bun": "1.4.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@types/seedrandom": "3.0.8",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@willbooster/oxfmt-config": "1.2.2",
    "@willbooster/oxlint-config": "1.4.8",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.5",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "lefthook": "2.1.12",
    "open-cli": "9.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wait-on": "9.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
