assert((fn() => 0) === null)
assert(false && fn() => 0)
assert(false && (fn() => 0))
assert(false && function () {
    if (true) {
        echo 1;
    } elseif (false) {
        echo 2;
    } elseif (false) {
        echo 3;
    } else {
        echo 4;
    }
})
assert(false && function () {
    if (true) {
        echo 1;
    } else if (false) {
        echo 2;
    } else {
        echo 3;
    }
})
assert(false && function () {
    if (true) {
        echo 1;
    } else {
        if (false) {
            echo 2;
        }
    }
})
assert(false && function () {
    echo 7;
    while (false) {
        break;
    }
    do {
        continue 1;
    } while (false);
    for (;;) {
        break;
    }
    return function () {
        return 1;
    };
})
assert(false && function () {
    foreach (['a' => 1] as $k => &$v) {
        unset($v);
        unset($k);
    }
    global $a;
    global $b;
    static $a = 1;
    static $b;
    throw new Exception();
})
assert(false && function () {
    try {
        throw new Exception();
    } catch (LogicException|RuntimeException $e) {
        echo 0;
    } finally {
        echo 'f';
    }
})
assert(false && function () {
    goto end;
    end:
    switch (1) {
        case 2:
            echo 3;
            break;
        default:
            return match (0) {
                0 => fn() => 2,
            };
    }
})
assert(false && function () {
    echo 1;
    echo 2;
    print 2;
    @(print 3);
    function nested(int $x = 3) {
        return $x;
    }

})
assert(false && function () {
    if (true) {
        return function () {
            return function () {
                return 1;
            };
        };
    }
})
assert(false && 'text' === (fn() => function () {
    return 4;
}))
assert(false && $x)
assert(false && $X)
assert(false && ${x-y})
assert(false && ${0})
assert(false && ${hello world})
assert(false && $猫)
